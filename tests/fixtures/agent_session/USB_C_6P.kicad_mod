(footprint "USB_C_Receptacle_6P"
  (layer "F.Cu")
  (descr "USB-C receptacle, 6 pin power only, approximate land pattern written by hand for the agent session test (own work, MIT)")
  (attr smd)
  (fp_line (start -4.47 -1.2) (end 4.47 -1.2) (layer "F.SilkS") (stroke (width 0.15) (type solid)))
  (fp_rect (start -5.2 -1.6) (end 5.2 6.2) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill none))
  (fp_rect (start -4.47 -0.8) (end 4.47 5.8) (layer "F.Fab") (stroke (width 0.1) (type solid)) (fill none))
  (pad "A12" smd rect (at -2.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "A9" smd rect (at -1.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "A5" smd rect (at -0.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "B5" smd rect (at 0.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "B9" smd rect (at 1.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "B12" smd rect (at 2.5 0) (size 0.7 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "S1" thru_hole circle (at -4.3 3.0) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "S2" thru_hole circle (at 4.3 3.0) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
