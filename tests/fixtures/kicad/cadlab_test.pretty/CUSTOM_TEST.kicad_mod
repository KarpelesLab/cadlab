(footprint "CUSTOM_TEST" (version 20211014) (generator cadlab_fixture)
  (layer "F.Cu")
  (descr "Hand-written footprint exercising every pad kind, for cadlab tests")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -4) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "CUSTOM_TEST" (at 0 4) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 3 0) (layer "F.Fab") (width 0.1) (fill none))
  (fp_line (start -3.5 -3.5) (end 3.5 -3.5) (layer "B.SilkS") (width 0.12))
  (fp_line (start -2 3) (end 2 3) (layer "F.Cu") (width 0.2))
  (fp_line (start -1 -1) (end 1 1) (layer "Edge.Cuts") (width 0.05))
  (fp_circle (center 0 0) (end 4 0) (layer "F.CrtYd") (width 0.05) (fill none))
  (pad "1" thru_hole circle (at -2 0) (size 1.6 1.6) (drill 0.8) (layers *.Cu *.Mask))
  (pad "2" thru_hole oval (at 2 0 90) (size 1.2 2.4) (drill oval 0.6 1.6) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 -2) (size 1.2 1.2) (drill 1.2) (layers *.Cu *.Mask))
  (pad "3" smd custom (at 0 2) (size 0.5 0.5) (layers "F.Cu" "F.Mask")
    (options (clearance outline) (anchor rect))
    (primitives
      (gr_poly (pts (xy -1 -0.4) (xy 1 -0.4) (xy 0 0.6)) (width 0) (fill yes))
    )
  )
  (pad "4" smd trapezoid (at 0 -1) (size 1 0.6) (rect_delta 0 0.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "5" smd roundrect (at 1.5 -2) (size 0.8 0.8) (layers "F.Cu" "F.Mask") (roundrect_rratio 0.25) (solder_mask_margin 0.05))
)
